# Cache du navigateur (Cloudflare Pages).
# /static : fichiers au nom unique par version (empreinte) : gardés un an.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Modèles, textures, ciel, sons, décodeur : gardés un jour, puis réutilisés
# pendant qu'une vérification se fait en arrière-plan (une semaine).
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/draco/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
